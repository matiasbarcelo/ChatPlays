{
  "name": "chatplays-desktop",
  "version": "0.1.0",
  "description": "ChatPlays desktop app (Electron + Python backend)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "start": "electron .",
    "preview": "npm run build && npm run start"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
